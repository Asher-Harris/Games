# Auto detect text files and ensure LF line endings
* text=auto

# Unreal Engine binary assets
*.uasset binary
*.umap binary
*.png binary
*.jpg binary
*.jpeg binary
*.bmp binary
*.tga binary
*.exr binary
*.hdr binary
*.wav binary
*.mp3 binary
*.ogg binary
*.fbx binary
*.obj binary
*.ttf binary
*.otf binary
*.webp binary
# Unreal project files
*.uproject text
*.uplugin text
# Godot
*.import text
*.tscn text
*.tres text
*.gd text
*.uasset filter=lfs diff=lfs merge=lfs -text
